# --- Google Cloud / Vertex AI (runtime evidence for contest gates) ---
# Copy to .env (never commit .env). On Replit use Secrets instead.
# GOOGLE_GENAI_USE_ENTERPRISE=true is the new name for
# GOOGLE_GENAI_USE_VERTEXAI; both are honored by the SDK.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=true
# Gemini 3.x models resolve via the GLOBAL endpoint only — regional
# locations (us-central1, europe-west1, ...) cannot serve them.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Replit alternative: paste the whole service-account JSON into ONE secret —
# the app materializes it to a file at startup (no path needed):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Alternatively, AI Studio key instead of Vertex:
# GOOGLE_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-3.7-flash
# Gemini 3.x ignores temperature/top-P/top-K; steer reasoning effort instead
# (MINIMAL / LOW / MEDIUM / HIGH):
# GEMINI_THINKING_LEVEL=LOW

# --- App ---
# REQUIRED: the app refuses to boot while this is unset/placeholder — crew
# personal links are HMACs of this secret. Local dev escape hatch:
# ALLOW_INSECURE_DEV_SECRET=1
# DEPLOY ORDER: set APP_SECRET and AD_PASSWORD in Replit Secrets BEFORE
# promoting a build — a missing APP_SECRET stops the whole app from booting.
APP_SECRET=change-me-to-a-long-random-string
# AD console auth (dashboard, publish/revert, /debug/*). Without AD_PASSWORD
# those routes answer 503 (fail closed).
AD_USERNAME=ad
AD_PASSWORD=choose-a-strong-password
# Crew/cast personal links: hours after issuance until links stop working
# (0 = never expire). "Rotate crew links" on the dashboard kills all live
# links/QRs instantly and issues fresh ones.
# TOKEN_TTL_HOURS=48
# Canonical public origin embedded in crew QR codes. Set this in production;
# never rely on the request Host header (spoofable). On Replit the domain is
# auto-detected from REPLIT_DEV_DOMAIN / REPLIT_DOMAINS when omitted.
# PUBLIC_BASE_URL=https://your-app.replit.app
# Host-header allowlist (comma-separated bare hostnames only, e.g.
# your-app.replit.app,.replit.dev). Do not include https:// or a path.
# localhost/127.0.0.1 are always allowed.
# TRUSTED_HOSTS=your-app.replit.app
DAY_START=07:00
DB_PATH=instance/backlot.db
SEED_DIR=seed

# --- Weather-aware suggestions (fixture-first; demo runs offline) ---
# Google Weather API key (Maps Platform — NOT the Vertex service account).
# Without it the dashboard serves committed fixtures and "Refresh forecast"
# explains it is not configured. With it, Refresh writes a runtime cache at
# instance/weather_cache.json (re-served for WEATHER_CACHE_MAX_AGE_MIN).
# GOOGLE_MAPS_API_KEY=your-maps-platform-key
# Hazard thresholds: an hour is hazardous at precip >= this %, or
# thunderstorm, or wind >= this km/h. Contiguous hours merge into one window.
# WEATHER_PRECIP_PCT=60
# WEATHER_WIND_KMH=40
# WEATHER_CACHE_MAX_AGE_MIN=60
# Demo clock override (HH:MM): pins the AD console's "now" for replans and
# the weather advisory regardless of server timezone — Replit runs UTC, so
# an afternoon demo beat would otherwise vanish. Unset = wall clock.
# NOW_OVERRIDE=09:00
